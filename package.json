{
	"name": "sf-icon-manager",
	"version": "0.4.0",
	"description": "Gutenberg block that inserts SVG icons from a sprite file (ico.svg) via <use> and links them.",
	"author": "Felix Müller (https://github.com/joeda1)",
	"license": "MIT",
	"main": "build/index.js",
	"files": [
		"assets",
		"build",
		"composer.json",
		"languages/*.pot",
		"src/admin",
		"src/icon.php",
		"src/sprite.php",
		"src/short-url.php",
		"vendor/autoload.php",
		"vendor/composer/autoload_real.php",
		"vendor/composer/autoload_static.php",
		"vendor/composer/ClassLoader.php",
		"vendor/composer/platform_check.php",
		"vendor/enshrined",
		"sprite.svg",
		"readme.txt",
		"sf-icon-manager.php",
		"uninstall.php"
	],
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint": "wp-scripts lint-js && wp-scripts lint-style",
		"typecheck": "tsc --noEmit",
		"test-unit-js": "wp-scripts test-unit-js",
		"check-engines": "wp-scripts check-engines",
		"plugin-zip": "composer install --no-dev --no-interaction --quiet && wp-scripts plugin-zip && composer install --no-interaction --quiet",
		"prepare": "husky"
	},
	"dependencies": {
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/i18n": "^6.29.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wordpress/scripts": "^36.0.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
