#. Plugin Name of the plugin
#: sf-icon-manager.php
#: src/admin/admin.php:18
#: src/admin/admin.php:19
#: src/admin/admin.php:288
#: src/native/icons.php:411
msgid "SVG Forge Icon Manager"
msgstr "SVG Forge Icon Manager"

#. Description of the plugin
#: sf-icon-manager.php
msgid "Gutenberg block that inserts SVG icons from a sprite file (ico.svg) via <use> and links them."
msgstr "Bloc Gutenberg qui insère des icônes SVG à partir d'un fichier sprite (ico.svg) via <use> et permet de les lier."

#. Author of the plugin
#: sf-icon-manager.php
msgid "svgforge"
msgstr "svgforge"

#: src/admin/admin.php:127
#: src/admin/admin.php:223
#: src/admin/admin.php:248
msgid "Sorry, you are not allowed to perform this action."
msgstr "Désolé, vous n'êtes pas autorisé à effectuer cette action."

#: src/admin/admin.php:292
msgid "Settings"
msgstr "Réglages"

#: src/admin/admin.php:295
#: src/admin/admin.php:647
msgid "Sprite preview"
msgstr "Aperçu du sprite"

#: src/admin/admin.php:329
msgid "Filter sfim_sprite_url"
msgstr "Filtre sfim_sprite_url"

#: src/admin/admin.php:333
msgid "Upload (Settings)"
msgstr "Téléversement (réglages)"

#: src/admin/admin.php:338
msgid "Default (sprite.svg bundled with the plugin)"
msgstr "Par défaut (sprite.svg fourni avec le plugin)"

#: src/admin/admin.php:343
msgid "The SVG sprite file was uploaded and is now being used."
msgstr "Le fichier sprite SVG a été téléversé et est maintenant utilisé."

#: src/admin/admin.php:344
msgid "The uploaded SVG sprite file was removed."
msgstr "Le fichier sprite SVG téléversé a été supprimé."

#: src/admin/admin.php:345
msgid "Only .svg or .svgz files can be uploaded."
msgstr "Seuls les fichiers .svg ou .svgz peuvent être téléversés."

#: src/admin/admin.php:346
msgid "The file could not be read."
msgstr "Le fichier n'a pas pu être lu."

#: src/admin/admin.php:347
msgid "The file is not a valid SVG file."
msgstr "Le fichier n'est pas un fichier SVG valide."

#: src/admin/admin.php:348
msgid "The file could not be written."
msgstr "Le fichier n'a pas pu être écrit."

#: src/admin/admin.php:349
msgid "Uploading is disabled because the sprite file is overridden by the sfim_sprite_url filter."
msgstr "Le téléversement est désactivé car le fichier sprite est remplacé par le filtre sfim_sprite_url."

#: src/admin/admin.php:350
msgid "The native icon integration setting was saved."
msgstr "Le paramètre d'intégration native des icônes a été enregistré."

#: src/admin/admin.php:367
msgid "The sprite file is currently overridden by the sfim_sprite_url filter. Uploading a sprite file is disabled while the filter is active."
msgstr "Le fichier sprite est actuellement remplacé par le filtre sfim_sprite_url. Le téléversement d'un fichier sprite est désactivé tant que le filtre est actif."

#: src/admin/admin.php:371
msgid "SVG fragment library"
msgstr "Bibliothèque de fragments SVG"

#: src/admin/admin.php:373
msgid "Upload an SVG sprite file that serves as the central SVG Forge Icon Manager for the SVG Icon block."
msgstr "Téléversez un fichier sprite SVG servant de gestionnaire central d'icônes SVG Forge pour le bloc SVG Icon."

#: src/admin/admin.php:374
msgid "Each icon is a <symbol id=\"my-icon\" viewBox=\"0 0 24 24\">…</symbol> element."
msgstr "Chaque icône est un élément <symbol id=\"my-icon\" viewBox=\"0 0 24 24\">…</symbol>."

#. translators: %1$d: Number of symbols registered with the native WordPress icon API.
#: src/admin/admin.php:384
#, php-format
msgid "WordPress 7.1+ only: %1$d symbol is also registered in the built-in Icon block and the wp/v2 icons REST API."
msgid_plural "WordPress 7.1+ only: these %1$d symbols are also registered in the built-in Icon block and the wp/v2 icons REST API."
msgstr[0] "Uniquement WordPress 7.1+ : %1$d symbole est également enregistré dans le bloc Icon intégré et l'API REST wp/v2 icons."
msgstr[1] "Uniquement WordPress 7.1+ : ces %1$d symboles sont également enregistrés dans le bloc Icon intégré et l'API REST wp/v2 icons."

#: src/admin/admin.php:396
msgid "WordPress 7.1+ only: the built-in Icon block is disabled. Use the SVG Icon block instead."
msgstr "Uniquement WordPress 7.1+ : le bloc Icon intégré est désactivé. Utilisez plutôt le bloc SVG Icon."

#: src/admin/admin.php:404
msgid "Active sprite file"
msgstr "Fichier sprite actif"

#: src/admin/admin.php:409
msgid "Short URL:"
msgstr "URL courte :"

#. translators: %s: Source of the sprite URL (filter, upload, default).
#: src/admin/admin.php:417
#, php-format
msgid "Source: %s"
msgstr "Source : %s"

#: src/admin/admin.php:426
msgid "Uploaded file"
msgstr "Fichier téléversé"

#. translators: %1$d: Number of symbol elements, %2$s: Date of the upload.
#: src/admin/admin.php:434
#, php-format
msgid "(%1$d symbols, uploaded on %2$s)"
msgstr "(%1$d symboles, téléversés le %2$s)"

#: src/admin/admin.php:445
msgid "Remove uploaded file"
msgstr "Supprimer le fichier téléversé"

#: src/admin/admin.php:455
#: src/admin/admin.php:467
msgid "WordPress native icon integration (experimental)"
msgstr "Intégration native des icônes WordPress (expérimental)"

#: src/admin/admin.php:457
msgid "Only relevant on WordPress 7.1+ which ships the built-in Icon block and the wp/v2 icons REST API. Experimental — the API and its behavior may change with core updates."
msgstr "Pertinent uniquement sur WordPress 7.1+ qui inclut le bloc Icon intégré et l'API REST wp/v2 icons. Expérimental — l'API et son comportement peuvent changer avec les mises à jour du noyau."

#: src/admin/admin.php:460
msgid "Note: the native path applies the core Icon block’s strict SVG sanitizer, so multi-color icon sets (e.g. Tango) may render incorrectly or not at all. The SVG Icon block renders sprite symbols without restrictions and is not affected."
msgstr "Remarque : la voie native applique le validateur SVG strict du bloc Icon du noyau, aussi les ensembles d'icônes multicolores (ex. Tango) peuvent s'afficher de façon incorrecte ou pas du tout. Le bloc SVG Icon affiche les symboles du sprite sans restrictions et n'est pas concerné."

#: src/admin/admin.php:473
msgid "Off"
msgstr "Désactivé"

#: src/admin/admin.php:476
msgid "Default. The plugin does not touch the WordPress icon API; the built-in Icon block stays as in core."
msgstr "Par défaut. Le plugin ne touche pas à l'API d'icônes de WordPress ; le bloc Icon intégré reste tel que dans le noyau."

#: src/admin/admin.php:482
msgid "Off, and hide WordPress core icon block"
msgstr "Désactivé et masquer le bloc d'icônes du noyau de WordPress"

#: src/admin/admin.php:485
msgid "Like Off, but the built-in core/icon block is deregistered in the block editor and on the frontend. Use the SVG Icon block instead."
msgstr "Comme « Désactivé », mais le bloc core/icon intégré est retiré de l'éditeur de blocs et du front-end. Utilisez plutôt le bloc SVG Icon."

#: src/admin/admin.php:491
msgid "On"
msgstr "Activé"

#: src/admin/admin.php:494
msgid "Every symbol of the configured sprite is registered as an icon in the sf-icon-manager collection — available in the built-in Icon block picker, the wp/v2 icons REST API and wp_get_icon()."
msgstr "Chaque symbole du sprite configuré est enregistré comme icône dans la collection sf-icon-manager — disponible dans le sélecteur du bloc Icon intégré, l'API REST wp/v2 icons et wp_get_icon()."

#: src/admin/admin.php:501
msgid "Save native icon settings"
msgstr "Enregistrer les paramètres natifs des icônes"

#: src/admin/admin.php:507
msgid "Upload new file"
msgstr "Téléverser un nouveau fichier"

#: src/admin/admin.php:509
msgid "An existing uploaded file is replaced by a new upload."
msgstr "Un fichier déjà téléversé est remplacé par un nouveau téléversement."

#: src/admin/admin.php:518
msgid "SVG file (ico.svg)"
msgstr "Fichier SVG (ico.svg)"

#: src/admin/admin.php:522
msgid "Only .svg and .svgz files are accepted. svgforge-cli handles full sanitization and svgo optimization; as a safety net, the plugin strips scripts, event handlers and javascript: links on upload."
msgstr "Seuls les fichiers .svg et .svgz sont acceptés. svgforge-cli assure l'assainissement complet et l'optimisation svgo ; par sécurité, le plugin supprime les scripts, les gestionnaires d'événements et les liens javascript: au téléversement."

#: src/admin/admin.php:530
msgid "Upload SVG sprite"
msgstr "Téléverser un sprite SVG"

#: src/admin/admin.php:535
msgid "Generate a sprite with svgforge-cli"
msgstr "Générer un sprite avec svgforge-cli"

#. translators: %1$s: opening link to the svgforge-cli repository; %2$s: closing link tag.
#: src/admin/admin.php:540
#, php-format
msgid "%1$sInstall svgforge-cli%2$s and create a symbol sprite from a folder of icons, then upload the generated SVG file."
msgstr "%1$sInstallez svgforge-cli%2$s, créez un sprite de symboles à partir d'un dossier d'icônes, puis téléversez le fichier SVG généré."

#: src/admin/admin.php:549
msgid "SVG files in subdirectories get IDs like directory--filename — each directory is then available as a filter in the icon picker."
msgstr "Les fichiers SVG des sous-dossiers reçoivent des identifiants du type dossier--nom-de-fichier — chaque dossier est ensuite disponible comme filtre dans le sélecteur d'icônes."

#. translators: %1$s: opening link to the svgforge tutorials; %2$s: closing link tag; %3$s: opening link to the example icon set repository; %4$s: closing link tag.
#: src/admin/admin.php:555
#, php-format
msgid "Tutorials: %1$ssvgforge.github.io%2$s · Example icon set with generated sprite: %3$ssvgforge/default-icons%4$s"
msgstr "Tutoriels : %1$ssvgforge.github.io%2$s · Exemple d'ensemble d'icônes avec sprite généré : %3$ssvgforge/default-icons%4$s"

#: src/admin/admin.php:638
msgid "No sprite is configured yet. Go to the settings tab to upload an SVG sprite file."
msgstr "Aucun sprite n'est encore configuré. Rendez-vous dans l'onglet réglages pour téléverser un fichier sprite SVG."

#: src/admin/admin.php:640
msgid "The configured sprite contains no symbols that can be previewed."
msgstr "Le sprite configuré ne contient aucun symbole pouvant être prévisualisé."

#. translators: %1$d: Number of previewed symbols, %2$s: Active sprite URL.
#: src/admin/admin.php:651
#, php-format
msgid "%1$d symbols in the active sprite (%2$s)."
msgstr "%1$d symboles dans le sprite actif (%2$s)."

